    "eval:record": "deno run --allow-env --allow-read --allow-write report-assistant/eval_record.ts"
  },
  "imports": {
    "@supabase/functions-js": "jsr:@supabase/functions-js@^2",
    "@supabase/server": "npm:@supabase/server@^1"
  }
