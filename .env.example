# Copy to `.env` (repo root, next to docker-compose.yml) and fill in.
# `.env` is git-ignored: never commit real secrets.

# REQUIRED. JWT signing key, >= 32 random bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start with a weak/placeholder key unless
# ENVIRONMENT is "development" or "test".
SECRET_KEY=

# production (default) | development | test
ENVIRONMENT=production

# Postgres password (db is NOT exposed outside the compose network).
# NOTE: only applied when the db volume is first created; changing it later
# requires ALTER USER inside Postgres.
POSTGRES_PASSWORD=postgres

# JWT lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# IANA timezone for billing day boundaries, night-rate windows and reports.
BUSINESS_TIMEZONE=America/Bogota

# Max size per evidence photo in bytes (default 5 MB). Clients should
# compress camera photos before upload; larger files get HTTP 413.
EVIDENCE_MAX_BYTES=5242880

# Comma-separated browser origins allowed by CORS. Empty = none (native
# Android/iOS apps do not need CORS). For Flutter web dev, e.g.:
#   CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# (run `flutter run -d chrome --web-port 5000` so the port is stable).
CORS_ORIGINS=

# Optional Redis for the shared cache (tariffs/categories/past revenue
# reports) and the login brute-force limiter, needed when running more than
# one backend worker/replica. docker-compose starts a `redis` service and
# defaults to it; set REDIS_URL= (empty) to use in-process implementations.
REDIS_URL=redis://redis:6379/0
